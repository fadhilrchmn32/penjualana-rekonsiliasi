# Shared Supabase Project (FINOPS_SHARED_V1 — sama untuk App 1, App 2, dan App 3)
# Gunakan URL dan Publishable/Anon Key proyek Supabase yang sama. Jangan pernah menaruh service_role key di frontend!
VITE_SUPABASE_URL="https://your-shared-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-or-anon-key"

# GEMINI_API_KEY: Required only if AI features are enabled server-side.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
